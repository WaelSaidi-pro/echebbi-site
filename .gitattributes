# Normalisation des fins de ligne : LF partout dans le depot et dans les copies de travail.
# Evite les diffs fantomes entre le poste Windows et la VM Linux de production.
* text=auto eol=lf

# Binaires : jamais de conversion
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.ico  binary
*.woff  binary
*.woff2 binary
